{
  "name": "jointglow-clinical-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "JointGlow Clinical: AI-assisted facial analysis and aesthetic treatment simulator for the iPhone front camera",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
